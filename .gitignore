*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# --- Environment & Secret Variables ---
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
*.pfx
secrets.json

